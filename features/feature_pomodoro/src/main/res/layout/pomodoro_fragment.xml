<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPomodoroSettings"
        style="@style/ContainerRangeOptionsButton"
        android:layout_marginEnd="8dp"
        android:backgroundTint="?appCardBackgroundColor"
        app:icon="@drawable/tab_settings"
        app:iconTint="?appInactiveColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/viewPomodoroTimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewPomodoroTimer">

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupPomodoroTimerHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="tvPomodoroTimerHours, tvPomodoroTimerHoursDelimiter, tvPomodoroTimerHoursLegend"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerHoursLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="@string/time_hour"
            android:textColor="?appTextHintColor"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/tvPomodoroTimerHours"
            app:layout_constraintEnd_toEndOf="@id/tvPomodoroTimerHours"
            app:layout_constraintStart_toStartOf="@id/tvPomodoroTimerHours" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:textColor="?appTextPrimaryColor"
            android:textSize="36sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPomodoroTimerHoursDelimiter"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="12" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerHoursDelimiter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-light"
            android:includeFontPadding="false"
            android:paddingHorizontal="2dp"
            android:text=":"
            android:textColor="?appTextPrimaryColor"
            android:textSize="36sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPomodoroTimerMinutes"
            app:layout_constraintStart_toEndOf="@id/tvPomodoroTimerHours"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerMinutesLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="@string/time_minute"
            android:textColor="?appTextHintColor"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/tvPomodoroTimerMinutes"
            app:layout_constraintEnd_toEndOf="@id/tvPomodoroTimerMinutes"
            app:layout_constraintStart_toStartOf="@id/tvPomodoroTimerMinutes" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:textColor="?appTextPrimaryColor"
            android:textSize="36sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPomodoroTimerMinutesDelimiter"
            app:layout_constraintStart_toEndOf="@id/tvPomodoroTimerHoursDelimiter"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="34" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerMinutesDelimiter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-light"
            android:includeFontPadding="false"
            android:paddingHorizontal="2dp"
            android:text=":"
            android:textColor="?appTextPrimaryColor"
            android:textSize="36sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPomodoroTimerSeconds"
            app:layout_constraintStart_toEndOf="@id/tvPomodoroTimerMinutes"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerSecondsLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="@string/time_second"
            android:textColor="?appTextHintColor"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/tvPomodoroTimerSeconds"
            app:layout_constraintEnd_toEndOf="@id/tvPomodoroTimerSeconds"
            app:layout_constraintStart_toStartOf="@id/tvPomodoroTimerSeconds" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroTimerSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:textColor="?appTextPrimaryColor"
            android:textSize="36sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvPomodoroTimerMinutesDelimiter"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="56" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierPomodoroTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvPomodoroTimerHours, tvPomodoroTimerMinutes, tvPomodoroTimerSeconds" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroCycleHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:textColor="?appTextHintColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierPomodoroTimes"
            tools:text="@string/pomodoro_state_focus" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/containerPomodoroHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroActivityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?appTextPrimaryColor"
            android:textSize="22sp"
            tools:text="Deep work" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?appTextPrimaryColor"
            android:textSize="16sp"
            tools:text="Writing the quarterly report" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroPausedTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?appTextHintColor"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Paused: Deep work"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroPausedComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?appTextHintColor"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Paused comment: No comment"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPomodoroEntryTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?appTextHintColor"
            android:textSize="14sp"
            tools:text="Total 1:23:45  \u00B7  Focus 1:10:00  \u00B7  Pause 0:13:45" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnPomodoroEditEntry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?selectableItemBackground"
            android:fontFamily="sans-serif-condensed"
            android:padding="6dp"
            android:text="@string/pomodoro_info_edit_entry"
            android:textColor="?colorSecondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tablePomodoroStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/flowPomodoroMainButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnPomodoroExpand"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:contentDescription="@string/pomodoro_info_expand"
                android:padding="4dp"
                android:scaleType="fitStart"
                app:srcCompat="@drawable/pomodoro_expand"
                app:tint="?appTextHintColor" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:gravity="end"
                android:text="@string/pomodoro_info_today"
                android:textColor="?appTextHintColor"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="end"
                android:text="@string/pomodoro_info_week"
                android:textColor="?appTextHintColor"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerPomodoroStatsRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/viewPomodoroTimer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:indicatorColor="?colorSecondary"
        app:indicatorInset="0dp"
        app:layout_constraintBottom_toTopOf="@id/tablePomodoroStats"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerPomodoroHeader"
        app:trackColor="?appDividerColor"
        app:trackCornerRadius="0dp"
        app:trackThickness="1dp"
        tools:max="100"
        tools:progress="75" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flowPomodoroMainButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        app:flow_horizontalGap="20dp"
        app:constraint_referenced_ids="btnPomodoroPrev, btnPomodoroStart, btnPomodoroNext, btnPomodoroRestart, btnPomodoroPause"
        app:flow_horizontalStyle="packed"
        app:flow_maxElementsWrap="3"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btnPomodoroRestart"
        style="@style/SettingsCard"
        android:layout_width="@dimen/additional_button_size"
        android:layout_height="@dimen/additional_button_size"
        android:foreground="?selectableItemBackground"
        app:cardCornerRadius="@dimen/additional_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?appContrastColor"
            app:srcCompat="@drawable/button_restart" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnPomodoroStart"
        style="@style/SettingsCard"
        android:layout_width="@dimen/main_button_width"
        android:layout_height="@dimen/main_button_height"
        android:foreground="?selectableItemBackground"
        app:cardCornerRadius="@dimen/main_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPomodoroButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?appContrastColor"
            tools:srcCompat="@drawable/button_stop" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnPomodoroPause"
        style="@style/SettingsCard"
        android:layout_width="@dimen/additional_button_size"
        android:layout_height="@dimen/additional_button_size"
        android:foreground="?selectableItemBackground"
        app:cardCornerRadius="@dimen/additional_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?appContrastColor"
            app:srcCompat="@drawable/button_pause" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnPomodoroPrev"
        style="@style/SettingsCard"
        android:layout_width="@dimen/additional_button_size"
        android:layout_height="@dimen/additional_button_size"
        android:foreground="?selectableItemBackground"
        app:cardCornerRadius="@dimen/additional_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rotation="180"
            android:scaleType="center"
            android:tint="?appContrastColor"
            app:srcCompat="@drawable/button_next" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnPomodoroNext"
        style="@style/SettingsCard"
        android:layout_width="@dimen/additional_button_size"
        android:layout_height="@dimen/additional_button_size"
        android:foreground="?selectableItemBackground"
        app:cardCornerRadius="@dimen/additional_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:tint="?appContrastColor"
            app:srcCompat="@drawable/button_next" />

    </androidx.cardview.widget.CardView>

    <ScrollView
        android:id="@+id/scrollPomodoroExpanded"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?appBackgroundColor"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnPomodoroCollapse"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="?selectableItemBackground"
                    android:contentDescription="@string/pomodoro_info_collapse"
                    android:padding="4dp"
                    android:scaleType="fitStart"
                    app:srcCompat="@drawable/pomodoro_collapse"
                    app:tint="?appTextHintColor" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="end"
                    android:text="@string/pomodoro_info_today"
                    android:textColor="?appTextHintColor"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="end"
                    android:text="@string/pomodoro_info_week"
                    android:textColor="?appTextHintColor"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerPomodoroExpandedRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cbPomodoroUnutilizedExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/pomodoro_info_include_unutilized"
                android:textColor="?appTextHintColor"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
