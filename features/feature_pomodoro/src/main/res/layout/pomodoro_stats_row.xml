<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:orientation="horizontal"
    android:paddingVertical="2dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPomodoroStatsIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="-12dp"
        android:visibility="gone"
        app:tint="?colorSecondary"
        tools:srcCompat="@drawable/pomodoro_break_cup"
        tools:visibility="visible" />

    <View
        android:id="@+id/viewPomodoroStatsDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/pomodoro_stats_dot"
        android:visibility="invisible"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPomodoroStatsName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:textColor="?appTextPrimaryColor"
        android:textSize="15sp"
        tools:text="UduTech" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPomodoroStatsToday"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="?appTextPrimaryColor"
        android:textSize="15sp"
        tools:text="9:29 / 10:00" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPomodoroStatsWeek"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="sans-serif-condensed"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="?appTextPrimaryColor"
        android:textSize="15sp"
        tools:text="9:29 / 10:00" />

</LinearLayout>
