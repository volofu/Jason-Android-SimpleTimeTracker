<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPomodoroButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?appCardBackgroundColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="?colorSecondary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/pomodoro"
                app:tint="?colorSecondary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPomodoroButtonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?appTextPrimaryColor"
                android:textSize="18sp"
                tools:text="Pomodoro" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPomodoroButtonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-condensed"
                android:textColor="?appTextHintColor"
                android:textSize="14sp"
                tools:text="Running" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
